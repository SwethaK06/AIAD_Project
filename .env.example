# =====================================================================
# GREEN LOGISTICS DASHBOARD - CENTRAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and adjust values for local development.
# =====================================================================

# PostgreSQL Database Credentials & Connection Configuration
POSTGRES_DB=green_logistics_db
POSTGRES_USER=green_admin
POSTGRES_PASSWORD=YourSecurePassword123!
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# PgAdmin Credentials
PGADMIN_EMAIL=admin@greenlogistics.com
PGADMIN_PASSWORD=YourPgAdminPassword123!

# Service Inter-Communication URLs
ML_SERVICE_URL=http://ml-service:8000/predict
DATABASE_URL=postgresql://green_admin:YourSecurePassword123!@postgres-db:5432/green_logistics_db
OSRM_BASE_URL=http://router.project-osrm.org

# Host Port Mappings
POSTGRES_PORT_HOST=5432
ML_SERVICE_PORT=8000
ROUTING_SERVICE_PORT=8001
DB_SERVICE_PORT=8002
FRONTEND_PORT=3000
